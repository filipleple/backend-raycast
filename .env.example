POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myapp

# Optional: promote this user to admin on boot (needed for the /admin panel).
ADMIN_USERNAME=

# Department of Vision gallery level: 629fm base URL for /api/dov (and
# /archive, unless DOV_WEB_URL is set). Empty = gallery walls stay empty.
DOV_API_URL=https://629fm.com
# Seconds each set of gallery images stays on the walls.
DOV_ROTATE_SECONDS=60
